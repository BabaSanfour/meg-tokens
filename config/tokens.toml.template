[project]
# All project data lives under one root. Expected layout:
#   raw/   -- raw CTF MEG acquisition (.ds sessions, NOISE_*.ds empty-room,
#             digitized head shapes)
#   tdms/  -- raw behavioral logs (LabVIEW TDMS)
#   IRM/   -- FreeSurfer subjects_dir (recon-all output, one folder per subject)
#   BIDS/  -- BIDS/sub-*/{meg,beh,anat} (raw layer) and BIDS/derivatives/sub-*
#             (pipeline outputs)
data_root = "/path/to/meg-tokens"

subjects_dir = "/path/to/meg-tokens/IRM"
trans_dir = "/path/to/trans-files"
noise_dir = "/path/to/noise-recordings"
task = "tokens"

# Subjects excluded from group analyses (MEG/data-quality review).
subject_exclusions = []

# Classify random ('x') trials from the correct-target design profile.
# Set false to use recorded 'e'/'a'/'m' labels only.
infer_random_classes = true

# TDMS files deliberately not ingested (short aborted/practice blocks).
behavior_ignore_files = [
    "temp_180214.tdms",  # H03: 9 trials, 09:57-09:59, between RT1 and Fast1
    "temp_181024.tdms",  # H18: 12 trials, ends 14:47, ~1 min before RT2 start
    "temp_181121.tdms",  # H23: 3 trials, 9 seconds total, ~3 min before RT2
]
