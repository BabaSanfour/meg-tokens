"""End-to-end MEG Tokens workflow over real staged derivatives."""

from pathlib import Path

from meg_tokens.io import DerivativeLayout
from meg_tokens.meg.band_power import LOCKS as BAND_POWER_LOCKS, PARCELLATION
from meg_tokens.meg.epoching import EPOCH_CONDITIONS
from meg_tokens.meg.meg_bids import raw_meg_path, raw_meg_sessions
from meg_tokens.behavior.analyses.sequential_sampling import ROBUSTNESS_CONFIGURATIONS


PROJECT_CONFIG = config["project_config"]
BIDS_ROOT = config["bids_root"]
SUBJECTS = config["subjects"]
PREPROCESSING = config.get("preprocessing", {})
LAYOUT = DerivativeLayout(BIDS_ROOT)
DERIVATIVES = Path(BIDS_ROOT) / "derivatives"
STATE = DERIVATIVES / ".workflow"
# Preprocessing writes one derivative per cleaner and both carry through to
# the source operators: the streams are compared on results.
STREAMS = tuple(PREPROCESSING.get("streams", ("dss", "ica")))
CLEAN_PATTERN = str(
    DERIVATIVES
    / "sub-{subject}"
    / "meg"
    / (
        "sub-{subject}_task-tokens_run-{run_number}_proc-{stream}"
        "_desc-{condition}_raw.fif"
    )
)
ARTIFACT_PATTERN = str(
    DERIVATIVES
    / "sub-{subject}"
    / "meg"
    / "sub-{subject}_task-tokens_run-{run_number}_proc-{stream}_desc-{condition}-artifact_raw.fif"
)
RUN_DERIVATIVE = str(DERIVATIVES / "sub-{subject}" / "meg" / "sub-{subject}_task-tokens_run-{run_number}")
TRANS_PATTERN = RUN_DERIVATIVE + "_desc-{condition}_trans.fif"
FORWARD_PATTERN = RUN_DERIVATIVE + "_desc-{condition}_fwd.fif"
INVERSE_PATTERN = RUN_DERIVATIVE + "_proc-{stream}_desc-{condition}_inv.fif"
BEAMFORMER_PATTERN = RUN_DERIVATIVE + "_proc-{stream}_desc-{condition}_lcmv.h5"
SUBJECT_DERIVATIVE = str(DERIVATIVES / "sub-{subject}" / "meg" / "sub-{subject}_task-tokens")
SOURCE_MODELS = {
    "cov": SUBJECT_DERIVATIVE + "_desc-noise_cov.fif",
    "bem": SUBJECT_DERIVATIVE + "_bem.fif",
    "src": SUBJECT_DERIVATIVE + "_space-subject_src.fif",
}
# Every staged recording, RT included: preprocessing covers the whole cohort,
# while the source operators follow the two epoched conditions.
PREPROCESS_TARGETS = [
    str(
        LAYOUT.preprocessed_raw(
            subject=subject,
            run=spec.run,
            condition=spec.condition,
            processing=stream,
        )
    )
    for subject in SUBJECTS
    for spec, _ in raw_meg_sessions(BIDS_ROOT, subject)
    for stream in STREAMS
]
SOURCE_TARGETS = [
    str(LAYOUT.inverse(subject=subject, run=spec.run, condition=spec.condition, stream=stream))
    for subject in SUBJECTS
    for spec, _ in raw_meg_sessions(BIDS_ROOT, subject)
    if spec.condition in EPOCH_CONDITIONS
    for stream in STREAMS
]
# Band power: the regions on the derivatives; every trial on fsaverage, about
# 24 TB for the cohort, only where `band_power.fsaverage_root` names a place.
FSAVERAGE_POWER_ROOT = config.get("band_power", {}).get("fsaverage_root")
BAND_POWER_PATTERN = SUBJECT_DERIVATIVE + "_proc-{stream}_space-{space}_desc-{lock}_power.h5"
BAND_POWER_TRIALS_PATTERN = SUBJECT_DERIVATIVE + "_proc-{stream}_desc-{lock}_trials.tsv"
FSAVERAGE_POWER_PATTERN = (
    None if FSAVERAGE_POWER_ROOT is None
    else str(Path(FSAVERAGE_POWER_ROOT) / "derivatives" / "sub-{subject}" / "meg"
             / "sub-{subject}_task-tokens_proc-{stream}_space-fsaverage_desc-{lock}_power.h5")
)
BAND_POWER_TARGETS = expand(BAND_POWER_TRIALS_PATTERN, subject=SUBJECTS, stream=STREAMS, lock=BAND_POWER_LOCKS)
# The behavioral stages each write many tables or figures, named inside the
# package. The DAG tracks them by one marker per job under the workflow state.
SSM = config.get("ssm", {})
SSM_FIT_STARTS = SSM.get("fit_starts", 3)
SSM_FOLDS = SSM.get("folds", 3)
SSM_ROBUSTNESS_STARTS = SSM.get("robustness_starts", 1)
SSM_EXCLUSION_STARTS = SSM.get("exclusion_starts", 2)
SSM_EXCLUSION_RULE = "complete_token_log_alignment"
SSM_RECOVERY_REPETITIONS = SSM.get("recovery_repetitions", 12)
BEHAVIOR_STATE = STATE / "behavior"
SSM_STATE = STATE / "ssm"
SSM_AGGREGATES = [
    str(SSM_STATE / f"{name}.done")
    for name in (
        "aggregate",
        "evaluate-aggregate",
        "robustness-aggregate",
        "exclusion-robustness-aggregate",
        "recovery-aggregate",
    )
]
BEHAVIOR_REPORT_TARGET = str(BEHAVIOR_STATE / "report.done")


rule all:
    input:
        SOURCE_TARGETS,
        BEHAVIOR_REPORT_TARGET,


rule band_power_all:
    input:
        BAND_POWER_TARGETS,


rule preprocess_all:
    input:
        PREPROCESS_TARGETS,


rule source_all:
    input:
        SOURCE_TARGETS,


rule behavior:
    output:
        str(BEHAVIOR_STATE / "sub-{subject}.done")
    shell:
        """
        meg-tokens --config {PROJECT_CONFIG:q} behavior ingest \
          --subjects {wildcards.subject:q}
        mkdir -p $(dirname {output:q})
        touch {output:q}
        """


rule behavior_analyze:
    input:
        expand(str(BEHAVIOR_STATE / "sub-{subject}.done"), subject=SUBJECTS)
    output:
        touch(str(BEHAVIOR_STATE / "analyze.done"))
    shell:
        "meg-tokens --config {PROJECT_CONFIG:q} behavior analyze"


rule behavior_characterization:
    input:
        rules.behavior_analyze.output
    output:
        touch(str(BEHAVIOR_STATE / "characterization.done"))
    shell:
        "meg-tokens --config {PROJECT_CONFIG:q} behavior characterization"


rule ssm_fit:
    input:
        rules.behavior_analyze.output
    output:
        touch(str(SSM_STATE / "fit" / "sub-{subject}.done"))
    threads: 8
    shell:
        """
        meg-tokens --config {PROJECT_CONFIG:q} behavior ssm-fit \
          --subjects {wildcards.subject:q} \
          --n-starts {SSM_FIT_STARTS} \
          --n-jobs {threads}
        """


rule ssm_aggregate:
    input:
        expand(str(SSM_STATE / "fit" / "sub-{subject}.done"), subject=SUBJECTS)
    output:
        touch(str(SSM_STATE / "aggregate.done"))
    shell:
        "meg-tokens --config {PROJECT_CONFIG:q} behavior ssm-aggregate"


rule ssm_evaluate:
    input:
        rules.ssm_aggregate.output
    output:
        touch(str(SSM_STATE / "evaluate" / "sub-{subject}.done"))
    shell:
        """
        meg-tokens --config {PROJECT_CONFIG:q} behavior ssm-evaluate \
          --subjects {wildcards.subject:q} \
          --folds {SSM_FOLDS} --n-starts 1 --recovery-repetitions 0
        """


rule ssm_evaluate_aggregate:
    input:
        expand(str(SSM_STATE / "evaluate" / "sub-{subject}.done"), subject=SUBJECTS)
    output:
        touch(str(SSM_STATE / "evaluate-aggregate.done"))
    shell:
        """
        meg-tokens --config {PROJECT_CONFIG:q} behavior ssm-evaluate-aggregate \
          --folds {SSM_FOLDS}
        """


rule ssm_robustness:
    input:
        rules.ssm_aggregate.output
    output:
        touch(str(SSM_STATE / "robustness" / "sub-{subject}_{configuration}.done"))
    wildcard_constraints:
        subject="[A-Za-z0-9]+",
    threads: 8
    shell:
        """
        meg-tokens --config {PROJECT_CONFIG:q} behavior ssm-robustness \
          --subjects {wildcards.subject:q} \
          --configuration {wildcards.configuration:q} \
          --n-starts {SSM_ROBUSTNESS_STARTS} \
          --n-jobs {threads}
        """


rule ssm_robustness_aggregate:
    input:
        expand(
            str(SSM_STATE / "robustness" / "sub-{subject}_{configuration}.done"),
            subject=SUBJECTS,
            configuration=ROBUSTNESS_CONFIGURATIONS,
        )
    output:
        touch(str(SSM_STATE / "robustness-aggregate.done"))
    shell:
        "meg-tokens --config {PROJECT_CONFIG:q} behavior ssm-robustness-aggregate"


rule ssm_exclusion_robustness:
    input:
        rules.ssm_aggregate.output
    output:
        touch(str(SSM_STATE / "exclusion-robustness" / "sub-{subject}.done"))
    threads: 8
    shell:
        """
        meg-tokens --config {PROJECT_CONFIG:q} behavior ssm-exclusion-robustness \
          --subjects {wildcards.subject:q} \
          --rule {SSM_EXCLUSION_RULE} \
          --n-starts {SSM_EXCLUSION_STARTS} \
          --n-jobs {threads}
        """


rule ssm_exclusion_robustness_aggregate:
    input:
        expand(
            str(SSM_STATE / "exclusion-robustness" / "sub-{subject}.done"),
            subject=SUBJECTS,
        )
    output:
        touch(str(SSM_STATE / "exclusion-robustness-aggregate.done"))
    shell:
        "meg-tokens --config {PROJECT_CONFIG:q} behavior ssm-exclusion-robustness-aggregate"


rule ssm_recovery:
    input:
        # the truth region is drawn from the pooled fits
        rules.ssm_aggregate.output
    output:
        touch(str(SSM_STATE / "recovery" / "rep-{repetition}.done"))
    threads: 8
    shell:
        """
        meg-tokens --config {PROJECT_CONFIG:q} behavior ssm-recovery \
          --repetitions {SSM_RECOVERY_REPETITIONS} \
          --repetition-index {wildcards.repetition} \
          --n-starts {SSM_FIT_STARTS}
        """


rule ssm_recovery_aggregate:
    input:
        expand(
            str(SSM_STATE / "recovery" / "rep-{repetition}.done"),
            repetition=range(SSM_RECOVERY_REPETITIONS),
        )
    output:
        touch(str(SSM_STATE / "recovery-aggregate.done"))
    shell:
        """
        meg-tokens --config {PROJECT_CONFIG:q} behavior ssm-recovery-aggregate \
          --repetitions {SSM_RECOVERY_REPETITIONS}
        """


rule preprocess:
    input:
        # The same discovery the stage itself uses, so the DAG edge and the
        # stage can never disagree about where Stage 0 put a recording.
        raw=lambda wildcards: str(
            raw_meg_path(
                BIDS_ROOT,
                wildcards.subject,
                wildcards.condition,
                wildcards.run_number,
            )
        )
    output:
        # One invocation writes every stream, because the trunk is shared: the
        # streams must not be separate jobs or each would recompute it and
        # they could disagree about bad channels and segments.
        raw=expand(CLEAN_PATTERN, stream=STREAMS, allow_missing=True),
        artifact=expand(ARTIFACT_PATTERN, stream=STREAMS, allow_missing=True),
    params:
        streams=" ".join(STREAMS),
    shell:
        """
        meg-tokens --config {PROJECT_CONFIG:q} meg preprocess \
          --subjects {wildcards.subject:q} \
          --run {wildcards.run_number:q} \
          --condition {wildcards.condition:q} \
          --streams {params.streams}
        """


EPOCHS_STATE = STATE / "epochs" / "sub-{subject}.done"
EPOCH_AMPLITUDES_STATE = STATE / "epochs" / "amplitudes" / "sub-{subject}.done"
EPOCH_THRESHOLDS = [str(LAYOUT.epoch_thresholds(stream=stream)) for stream in STREAMS]


def cleaned_fast_slow(wildcards):
    return [
        str(LAYOUT.preprocessed_raw(
            subject=wildcards.subject, run=spec.run, condition=spec.condition, processing=stream,
        ))
        for spec, _ in raw_meg_sessions(BIDS_ROOT, wildcards.subject)
        if spec.condition in EPOCH_CONDITIONS
        for stream in STREAMS
    ]


rule epoch_amplitudes:
    input:
        trial_features=rules.behavior_analyze.output,
        raw=cleaned_fast_slow,
    output:
        touch(str(EPOCH_AMPLITUDES_STATE))
    shell:
        """
        meg-tokens --config {PROJECT_CONFIG:q} meg epoch-amplitudes \
          --subjects {wildcards.subject:q} \
          --streams {STREAMS}
        """


# The outlier thresholds come from the whole cohort, so every subject's
# amplitudes are in before any subject's epochs are cut.
rule epoch_thresholds:
    input:
        expand(str(EPOCH_AMPLITUDES_STATE), subject=SUBJECTS)
    output:
        EPOCH_THRESHOLDS
    shell:
        """
        meg-tokens --config {PROJECT_CONFIG:q} meg epoch-thresholds \
          --subjects {SUBJECTS} \
          --streams {STREAMS}
        """


rule epochs:
    input:
        trial_features=rules.behavior_analyze.output,
        thresholds=EPOCH_THRESHOLDS,
        raw=cleaned_fast_slow,
    output:
        touch(str(EPOCHS_STATE))
    shell:
        """
        meg-tokens --config {PROJECT_CONFIG:q} meg epoch \
          --subjects {wildcards.subject:q} \
          --streams {STREAMS}
        """

rule source_models:
    input:
        # The stage finds the nearest empty room from the acquisition times.
        scans=str(Path(BIDS_ROOT) / "sub-{subject}" / "sub-{subject}_scans.tsv"),
    output:
        **SOURCE_MODELS,
    shell:
        """
        meg-tokens --config {PROJECT_CONFIG:q} meg source-models \
          --subjects {wildcards.subject:q}
        """


rule source:
    input:
        **SOURCE_MODELS,
        trans=TRANS_PATTERN,
        raw=expand(CLEAN_PATTERN, stream=STREAMS, allow_missing=True),
        artifact=expand(ARTIFACT_PATTERN, stream=STREAMS, allow_missing=True),
    output:
        fwd=FORWARD_PATTERN,
        inv=expand(INVERSE_PATTERN, stream=STREAMS, allow_missing=True),
        lcmv=expand(BEAMFORMER_PATTERN, stream=STREAMS, allow_missing=True),
    params:
        streams=" ".join(STREAMS),
    shell:
        """
        meg-tokens --config {PROJECT_CONFIG:q} meg source \
          --subjects {wildcards.subject:q} \
          --run {wildcards.run_number:q} \
          --condition {wildcards.condition:q} \
          --streams {params.streams}
        """


def subject_inverses(wildcards):
    return [
        str(LAYOUT.inverse(subject=wildcards.subject, run=spec.run, condition=spec.condition, stream=stream))
        for spec, _ in raw_meg_sessions(BIDS_ROOT, wildcards.subject)
        if spec.condition in EPOCH_CONDITIONS
        for stream in STREAMS
    ]


rule band_power:
    input:
        epochs=str(EPOCHS_STATE),
        inv=subject_inverses,
    output:
        regions=expand(BAND_POWER_PATTERN, stream=STREAMS, space=PARCELLATION, lock=BAND_POWER_LOCKS, allow_missing=True),
        trials=expand(BAND_POWER_TRIALS_PATTERN, stream=STREAMS, lock=BAND_POWER_LOCKS, allow_missing=True),
        fsaverage=(
            expand(FSAVERAGE_POWER_PATTERN, stream=STREAMS, lock=BAND_POWER_LOCKS, allow_missing=True)
            if FSAVERAGE_POWER_PATTERN else []
        ),
    params:
        streams=" ".join(STREAMS),
        locks=" ".join(BAND_POWER_LOCKS),
        fsaverage=f"--fsaverage-root {FSAVERAGE_POWER_ROOT}" if FSAVERAGE_POWER_ROOT else "",
    shell:
        """
        meg-tokens --config {PROJECT_CONFIG:q} meg band-power \
          --subjects {wildcards.subject:q} \
          --streams {params.streams} \
          --locks {params.locks} \
          {params.fsaverage}
        """


rule behavior_report:
    input:
        rules.behavior_characterization.output,
        SSM_AGGREGATES,
    output:
        touch(BEHAVIOR_REPORT_TARGET)
    shell:
        "meg-tokens --config {PROJECT_CONFIG:q} report behavior --figures all"
