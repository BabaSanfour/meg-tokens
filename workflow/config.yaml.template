# Copy to workflow/config.yaml and point the roots at this machine. The copy is
# untracked: the desktop and the cluster hold the same dataset at different
# paths, so a committed root would be wrong on one of them.
project_config: tokens.toml
bids_root: /path/to/tokens-bids

subjects:
  - H01
  - H02
  - H03
  - H04
  - H05
  - H06
  - H07
  - H08
  - H09
  - H10
  - H11
  - H12
  - H13
  - H14
  - H15
  - H16
  - H17
  - H18
  - H19
  - H20
  - H21
  - H22
  - H23
  - H24
  - H25
  - H26
  - H27
  - H28
  - H29
  - H30
  - H31
  - H32

runs:
  Fast:
    - Fast1
    - Fast2
    - Fast3
    - Fast4
  Slow:
    - Slow1
    - Slow2
    - Slow3
    - Slow4

alignment: go
source_method: dSPM
spacing: oct6
parcellation: HCPMMP1
feature_space: parcellated
power_method: hilbert
power_bands:
  - theta
  - alpha
  - beta

preprocessing:
  # Cleaners to write, and which one the downstream stages consume.
  streams: [dss, ica]
  stream: ica

statistics:
  permutations: 1000
  n_jobs: 1

decoding:
  permutations: 100
  n_jobs: 4

decomposition:
  n_components: 20
